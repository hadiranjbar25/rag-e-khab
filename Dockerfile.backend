# syntax=docker/dockerfile:1.7
FROM gradle:9.2.1-jdk25 AS build
WORKDIR /workspace
COPY settings.gradle.kts build.gradle.kts gradle.properties ./
COPY backend/build.gradle.kts backend/build.gradle.kts
COPY agent/build.gradle.kts agent/build.gradle.kts
ENV GRADLE_OPTS="-Dorg.gradle.daemon=false -Dorg.gradle.workers.max=2 -Dkotlin.compiler.execution.strategy=in-process"
RUN --mount=type=cache,target=/home/gradle/.gradle gradle :backend:dependencies --no-daemon --stacktrace
COPY backend backend
RUN --mount=type=cache,target=/home/gradle/.gradle gradle :backend:bootJar --no-daemon --stacktrace

FROM eclipse-temurin:25-jre
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /workspace/backend/build/libs/*.jar /app/rag-e-khab.jar
EXPOSE 8060
ENTRYPOINT ["java", "-jar", "/app/rag-e-khab.jar"]
